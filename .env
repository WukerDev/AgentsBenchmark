# AI Provider Selection: 'ollama', 'groq', 'openai', 'openrouter'
DEFAULT_PROVIDER=ollama

# Ollama Settings (Local)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_KEEP_ALIVE=5m

# Cloud Providers (Optional - fill in if using Groq / OpenAI / OpenRouter)
GROQ_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Global Benchmark Settings
BENCHMARK_SEED=2026
MAX_GROUP_TURNS=15
MAX_SOLO_TURNS=5
